  indexes {
    (establishment_id, id) [name: 'audit_events_establishment_id_id_key', unique]
    (establishment_id, occurred_at) [name: 'ix_audit_events_timeline']
    (establishment_id, actor_id) [name: 'ix_fk_6a633026a0bb87c701fb']
  }
}

