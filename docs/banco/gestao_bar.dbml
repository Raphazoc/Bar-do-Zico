// Gerado do PostgreSQL por scripts/export_dbml.py. Não substitui as migrações.
// Índices parciais têm o predicado em note; UNIQUE só vale quando o predicado é verdadeiro.
Project gestao_bar {
  database_type: 'PostgreSQL'
  Note: 'MVP: 33 tabelas de negócio/referência e 2 de infraestrutura da API. Checks, triggers, views e condições de índices estão nas migrações SQL.'
}

Table bar.account_adjustments {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  establishment_id uuid [not null]
  account_id uuid [not null]
  order_item_id uuid
  actor_id uuid [not null]
  authorized_by uuid
  reverses_id uuid
  kind varchar(25) [not null]
  amount numeric(14,2) [not null]
  rate numeric(7,4)
  base_amount numeric(14,2)
  reason text [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (establishment_id, id) [name: 'account_adjustments_establishment_id_id_key', unique]
    (establishment_id, reverses_id) [name: 'account_adjustments_establishment_id_reverses_id_key', unique]
    (establishment_id, actor_id) [name: 'ix_fk_1bd65fdd90560518085c']
    (establishment_id, authorized_by) [name: 'ix_fk_b0ba8bdff5805e6abeda']
    (establishment_id, account_id) [name: 'ix_fk_dfbe8d404069aeb60583']
    (establishment_id, order_item_id) [name: 'ix_fk_eb62d3a341ce699b5adb']
  }
}

Table bar.accounts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  establishment_id uuid [not null]
  table_id uuid
  opened_by uuid [not null]
  status varchar(25) [not null, default: `'ABERTA'::character varying`]
  opened_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  closed_at timestamptz
  version bigint [not null, default: `0`]
  indexes {
    (establishment_id, id) [name: 'accounts_establishment_id_id_key', unique]
    (establishment_id, opened_at) [name: 'ix_accounts_open', note: 'Parcial: ((status)::text = ANY ((ARRAY[\'ABERTA\'::character varying, \'EM_FECHAMENTO\'::character varying])::text[]))']
    (establishment_id, opened_by) [name: 'ix_fk_22ca650a5b85b67caab3']
    (establishment_id, table_id) [name: 'ix_fk_6990e40b9c2ddeb79cdd']
    (establishment_id, table_id) [name: 'uq_accounts_active_table', note: 'UNIQUE parcial: ((table_id IS NOT NULL) AND ((status)::text = ANY ((ARRAY[\'ABERTA\'::character varying, \'EM_FECHAMENTO\'::character varying])::text[])))']
  }
}

Table bar.app_sessions {
